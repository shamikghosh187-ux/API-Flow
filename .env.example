# Supabase (server-side and public URL/anon key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gateway authentication (generate a long random secret)
API_FLOW_MASTER_KEY=

# Provider keys — server-side only
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

# App
APP_URL=http://localhost:3000

# Optional comma-separated key pools (preferred when using multiple keys)
# Example: GROQ_API_KEYS=key_one,key_two,key_three
GROQ_API_KEYS=
OPENROUTER_API_KEYS=
OPENAI_API_KEYS=
DEEPSEEK_API_KEYS=
MISTRAL_API_KEYS=
